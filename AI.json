    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst toolCallId = $('Parse VAPI Request').first().json.toolCallId;\n\nconst properties = items.map(i => ({\n  id: i.json.Propert_Id,\n  title: i.json.Title,\n  price: i.json.PRICE,\n  bedrooms: i.json.Bedroom,\n  location: i.json.LOCATION\n}));\n\nconst result = properties.length > 0\n  ? \"Found \" + properties.length + \" properties: \" + properties.map(p => p.title + \" with \" + p.bedrooms + \" bedrooms, price: \" + p.price + \" in \" + p.location).join(\"; \")\n  : \"No properties found matching your criteria\";\n\nreturn [{\n  json: {\n    results: [{\n      toolCallId: toolCallId,\n      result: result\n    }]\n  }\n}];"
      },
      "id": "91e2c63e-181b-4993-87b8-8ecc673d9f3e",
