    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst toolCallId = $('Parse VAPI Request').first().json.toolCallId;\n\nconst result = item.id\n  ? `Viewing booked successfully for ${item.start?.dateTime || 'scheduled time'}. Confirmation ID: ${item.id}`\n  : 'Booking failed - please try another time';\n\nreturn [{\n  json: {\n    results: [{\n      toolCallId: toolCallId,\n      result: result\n    }]\n  }\n}];"
      },
