    {
      "parameters": {
        "jsCode": "const callData = $('Extract Call Data').first().json;\nconst aiResponse = $input.first().json;\n\nlet analysis = {};\ntry {\n  const content = aiResponse.choices?.[0]?.message?.content || '{}';\n  analysis = typeof content === 'string' ? JSON.parse(content) : content;\n} catch(e) {\n  analysis = { sentiment: 'neutral', lead_score: 5, is_hot: false, summary: 'Parse error', next_action: 'Manual review' };\n}\n\nreturn [{\n  json: {\n    call_id: callData.call_id,\n    client_name: callData.client_name,\n    phone: callData.phone,\n    call_date: callData.call_date,\n    duration: callData.duration,\n    transcript: callData.transcript,\n    sentiment: analysis.sentiment || 'neutral',\n    lead_score: analysis.lead_score || 5,\n    is_hot: analysis.is_hot || false,\n    summary: analysis.summary || '',\n    next_action: analysis.next_action || '',\n    follow_up_date: new Date(Date.now() + 3*24*60*60*1000).toISOString().split('T')[0]\n  }\n}];"
      },
