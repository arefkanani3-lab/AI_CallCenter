    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst toolCallId = $('Parse VAPI Request').first().json.toolCallId;\n\nconst exists = item && item.client_id;\nconst result = exists\n  ? `Client found: ${item.name}, Status: ${item.status}, Budget: ${item.budget_min}-${item.budget_max}`\n  : 'New client - not in database';\n\nreturn [{\n  json: {\n    results: [{\n      toolCallId: toolCallId,\n      result: result\n    }]\n  }\n}];"
      },
