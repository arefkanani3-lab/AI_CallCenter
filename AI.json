    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst message = body.message || {};\nconst call = message.call || {};\nconst customer = call.customer || message.customer || {};\n\nconst phoneNumber = customer.number || call.phone_number || message.artifact?.callerNumber || 'Unknown';\n\nreturn [{\n  json: {\n    call_id: call.id || '',\n    client_name: customer.name || 'Unknown',\n    phone: phoneNumber,\n    call_date: new Date().toISOString(),\n    duration: message.durationSeconds || 0,\n    transcript: message.transcript || message.artifact?.transcript || '',\n    summary_raw: message.summary || ''\n  }\n}];"
      },
